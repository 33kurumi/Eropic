<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- M0 只读：只申请读取图片所需的最小权限，不申请网络权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14+ 用户可能只授权部分照片，必须能感知这种状态 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 查看器里「设为壁纸」需要，属于普通权限，不弹窗、不需用户手动授权 -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- M3 真实移动/回收站/永久删除需要"所有文件访问"。Eropic 只侧载分发、不上架 Play，
         因此不需要提交 ALL_FILES 使用申报（决策见 docs/dev/05 ADR-0012）。
         未授予时写操作入口全部禁用，只读功能不受影响。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".EropicApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eropic"
        tools:targetApi="36">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Eropic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>