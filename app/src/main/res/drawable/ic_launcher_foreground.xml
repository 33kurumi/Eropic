<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Eropic 图标前景：两张叠在一起的"照片卡片"，前面一张有山与太阳。
         全部图形都落在自适应图标的安全区（18..90）内，圆形/方形遮罩都不会被切掉。 -->

    <!-- 后面那张卡片：稍微错位，30% 白，做出层次 -->
    <path
        android:fillColor="#4DFFFFFF"
        android:pathData="M26,28h44a8,8 0 0 1 8,8v44a8,8 0 0 1 -8,8h-44a8,8 0 0 1 -8,-8v-44a8,8 0 0 1 8,-8z" />

    <!-- 前面那张卡片 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,34h44a9,9 0 0 1 9,9v44a9,9 0 0 1 -9,9h-44a9,9 0 0 1 -9,-9v-44a9,9 0 0 1 9,-9z" />

    <!-- 卡片内的山：青绿渐变 -->
    <path android:pathData="M38,84L54,58L64,72L70,64L92,84z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="92"
                android:endY="84"
                android:startX="38"
                android:startY="58"
                android:type="linear">
                <item
                    android:color="#2DD4BF"
                    android:offset="0.0" />
                <item
                    android:color="#0E7C86"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 太阳 -->
    <path
        android:fillColor="#2DD4BF"
        android:pathData="M76,45a6,6 0 1 0 12,0a6,6 0 1 0 -12,0z" />
</vector>